{
  "title": "Shadow Internet - API health",
  "uid": "shadow-api",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "HTTP requests / second",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "shadow-prometheus"},
      "targets": [{"expr": "sum by (status) (rate(shadow_http_requests_total[5m]))", "legendFormat": "{{status}}"}]
    },
    {
      "id": 2, "type": "timeseries", "title": "p95 HTTP latency",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "shadow-prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(shadow_http_request_seconds_bucket[5m])))"}]
    },
    {
      "id": 3, "type": "stat", "title": "Scans accepted",
      "gridPos": {"x": 0, "y": 8, "w": 8, "h": 5},
      "datasource": {"type": "prometheus", "uid": "shadow-prometheus"},
      "targets": [{"expr": "shadow_scan_requests_total"}]
    }
  ]
}
