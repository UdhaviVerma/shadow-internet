ENVIRONMENT=development
AUTH_MODE=demo
DATABASE_URL=sqlite:///./shadow.db
QUEUE_MODE=inline
FRONTEND_ORIGIN=http://localhost:3000
# Development-only live scans: AUTH_MODE=development. Never expose this mode publicly.
# Production: ENVIRONMENT=production, AUTH_MODE=clerk, QUEUE_MODE=celery
# DATABASE_URL=postgresql+psycopg://...?...sslmode=require
# REDIS_URL=rediss://...
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_AUDIENCE=optional-configured-audience
# OPENAI_API_KEY=optional-authenticated-analyst-only
OPENAI_MODEL=gpt-4.1-mini
SCAN_LIMIT_PER_HOUR=10
